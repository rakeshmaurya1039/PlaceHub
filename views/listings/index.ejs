<% layout("/layouts/boilerplate")%>
<body>
  <style>
.filters-wrapper {
   display: flex; 
   align-items: center;
   gap: 12px; 
   padding: 12px 0;
   border-bottom: 1px solid #eee; 
   max-width: 100%;
  } 
    /* slider container */ 
  #filters { 
      display: flex;
      gap: 28px;
      overflow-x: hidden;
      scroll-behavior: smooth; 
      flex: 1;
      min-width: 0;
      margin: 1rem 0; 
  }

   .filter {
     min-width: 72px;
     text-align: center; 
     opacity: 0.7; 
     font-size: 12px; 
    } 

    .filter i {
       font-size: 18px;
       margin-bottom: 6px;
    }
    .filter p { 
      font-size: 12px; 
      margin: 0; 
      white-space: nowrap; 
    } 

    .filter:hover { 
      opacity: 1; 
      cursor: pointer; 
    } 

    .scroll-btn {
      width: 32px; 
      height: 32px; 
      border-radius: 50%; 
      border: 1px solid #ddd; 
      background: #fff; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      cursor: pointer; 
    }
    
    .scroll-btn i { 
      font-size: 14px; 
    }
    
    .scroll-btn:hover { 
      box-shadow: 0 2px 6px rgba(0,0,0,0.15); 
    } 
    
    #filters::-webkit-scrollbar {
       display: none; 
    }

@media (max-width: 768px) {
  #filters {
    width: 100%;
  }
}


.tax-info {
  display: none;
}

  .tax-toggle {
    border: 1px solid black;
    padding: 0.7rem;
    border-radius: 1rem;
    margin-left: auto;
    display: flex;
    align-items: center;
  }

 
</style>
<div class="container"></div>
 <!-- <h3>All listigs</h3> --> 
  <div class="filters-wrapper"> 
    <button class="scroll-btn left" onclick="scrollFilters(-1)">
       <i class="fa-solid fa-chevron-left"></i> 
    </button> 
    
    <div id="filters"> 
      <a href="/listings?category=Beach"
         class="filter text-decoration-none text-dark">
        <div> <i class="fa-solid fa-fire"></i></div> 
        <p>Trending</p> 
      </a>

     <a href="/listings?category=Beach"
       class="filter text-decoration-none text-dark">
        <div> <i class="fa-solid fa-bed"></i></div> 
        <p>Rooms</p> 
      </a>

     <a href="/listings?category=Beach"
      class="filter text-decoration-none text-dark">
        <div> <i class="fa-solid fa-mountain-city"></i></div> 
        <p>Iconic Cities</p> 
    </a> 

      <a href="/listings?category=Beach"
        class="filter text-decoration-none text-dark">
        <div> <i class="fa-solid fa-mountain"></i></div> 
        <p>Mountains</p> 
      </a> 

      <a href="/listings?category=Beach"
         class="filter text-decoration-none text-dark"> 
        <div> <i class="fa-brands fa-fort-awesome"></i></div> 
        <p>Castles</p> 
      </a> 


      <a href="/listings?category=Beach"
        class="filter text-decoration-none text-dark">
        <div> <i class="fa-solid fa-person-swimming"></i></div> 
        <p>Amezing Pools</p> 
      </a> 
      <div class="filter"> 
        <div> <i class="fa-solid fa-campground"></i></div> 
        <p>Camping</p> 
      </div> 
      <div class="filter"> 
        <div> <i class="fa-solid fa-cow"></i></div> 
        <p>Farms</p> 
      </div> 
      <div class="filter"> 
        <div> <i class="fa-solid fa-snowflake"></i></div> 
        <p>Arctic</p> 
      </div> 
      <div class="filter"> 
        <div><i class="fa-solid fa-umbrella-beach"></i></div> 
        <p>Beach</p> 
      </div> 
      <div class="filter"> 
        <div><i class="fa-solid fa-hotel"></i></div> 
        <p>Hotel</p> 
      </div> 
      <div class="filter"> 
        <div> <i class="fa-regular fa-heart"></i></div> 
        <p>Romantic</p> 
      </div> 
      <div class="filter"> 
        <div><i class="fa-solid fa-water"></i></div> 
        <p>Lakefront</p> 
      </div> 
      <div class="filter"> 
        <div><i class="fa-solid fa-diamond"></i></div> 
        <p>Luxiary</p> 
      </div> 
    </div> 
    <button class="scroll-btn right" onclick="scrollFilters(1)">
       <i class="fa-solid fa-chevron-right"></i> 
    </button>  

    <div class="tax-toggle ">
      <div class="form-check-reverse form-switch ">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
          <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
      </div>
</div>
</div>

 
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
      <% for(listing of allListings) { %>
        <a href="/listings/<%= listing._id%>" class="listing-link">
          <div class="card col listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="image-listing" style="height: 20rem;">
        
            <div class="card-img-overlay"></div>
            <div class="card-body">
               <p class="card-text">
               <b> <%= listing.title %></b> <br>
              Price : &#8377;
              <%= listing.price != null ? listing.price.toLocaleString('en-IN') : "N/A" %>/night<i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
              </p>
            </div>
          </div>
        </a>
      <%} %>   
    </div> 



<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", () =>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
      
    }
  })
</script>
<script>
  const filters = document.getElementById("filters");
  const scrollAmount = 200; // pixels to scroll per click

  function scrollFilters(direction) {
    filters.scrollBy({
      left: direction * scrollAmount,
      behavior: "smooth"
    });
  }
</script>

