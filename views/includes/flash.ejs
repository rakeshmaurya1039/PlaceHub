<!-- success flash -->
<% if(success && success.length){ %>
    <div class="alert-success alert alert-dismissible fade show col-5 offset-3" role="alert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %> 

<!-- error flash -->
 <% if(error && error.length){ %>
    <div class="alert-danger alert alert-dismissible fade show col-5 offset-3" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %> 